<Window x:Class="TLauncherRemake.AccountLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/TLauncherRemake;component/Assets/launcher.ico"
        Title="Вход в аккаунт Minecraft"
        Width="430"
        Height="180"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Вход в аккаунт Minecraft"
                   FontFamily="Arial"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#1E88C7"/>

        <TextBlock Grid.Row="1"
                   Text="Войдите в аккаунт Microsoft, к которому привязан Minecraft."
                   FontFamily="Arial"
                   FontSize="11"
                   Foreground="#333333"
                   TextWrapping="Wrap"
                   Margin="0,10,0,14"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal">
            <Button x:Name="LoginButton"
                    Content="Войти через Microsoft"
                    Width="180"
                    Height="32"
                    Background="#408AD2"
                    Foreground="#FFFFFF"
                    FontFamily="Arial"
                    FontSize="11"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="LoginButton_Click"/>
            <Button Content="Отмена"
                    Width="90"
                    Height="32"
                    Margin="10,0,0,0"
                    Background="#679ED2"
                    Foreground="#FFFFFF"
                    FontFamily="Arial"
                    FontSize="11"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="CancelButton_Click"/>
        </StackPanel>

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   FontFamily="Arial"
                   FontSize="10"
                   Foreground="#666666"
                   TextWrapping="Wrap"
                   VerticalAlignment="Bottom"/>
    </Grid>
</Window>
