                            <StackPanel Margin="18,12,18,0">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Консоль разработчика:" Style="{StaticResource SettingsLabelStyle}"/>
                                    <ComboBox Grid.Column="1"
                                              Width="405"
                                              HorizontalAlignment="Left"
                                              Style="{StaticResource SettingsComboBoxStyle}"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="Отключена"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Качество соединения:" Style="{StaticResource SettingsLabelStyle}"/>
                                    <ComboBox Grid.Column="1"
                                              Width="405"
                                              HorizontalAlignment="Left"
                                              Style="{StaticResource SettingsComboBoxStyle}"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="Хорошее"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="При запуске Minecraft:" Style="{StaticResource SettingsLabelStyle}"/>
                                    <ComboBox Grid.Column="1"
                                              Width="405"
                                              HorizontalAlignment="Left"
                                              Style="{StaticResource SettingsComboBoxStyle}"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="Скрывать TLauncher"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Язык (language):" Style="{StaticResource SettingsLabelStyle}"/>
                                    <Border Grid.Column="1"
                                            Width="405"
                                            Height="23"
                                            HorizontalAlignment="Left"
                                            Background="#67AEDE">
                                        <TextBlock Text="Русский (Russian)"
                                                   Foreground="#1F1F1F"
                                                   FontFamily="Arial"
                                                   FontSize="10"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Размер TLauncher:" Style="{StaticResource SettingsLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ComboBox Width="60"
                                                  Style="{StaticResource SettingsComboBoxStyle}"
                                                  SelectedIndex="0">
                                            <ComboBoxItem Content="100"/>
                                        </ComboBox>
                                        <TextBlock Text="%"
                                                   FontFamily="Arial"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Margin="5,0"/>
                                        <TextBlock Text="?"
                                                   Foreground="#2B95D7"
                                                   FontFamily="Arial"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Восстановление игрового прогресса"
                                           FontFamily="Arial"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#222222"
                                           Margin="0,2,0,8"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Делать бэкапы:" Style="{StaticResource SettingsLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <CheckBox Content="Да"
                                                  IsChecked="True"
                                                  Style="{StaticResource SettingsCheckBoxStyle}"/>
                                        <TextBlock Text="?"
                                                   Foreground="#2B95D7"
                                                   FontFamily="Arial"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Частота бэкапа:" Style="{StaticResource SettingsLabelStyle}"/>
                                    <ComboBox Grid.Column="1"
                                              Width="405"
                                              HorizontalAlignment="Left"
                                              Style="{StaticResource SettingsComboBoxStyle}"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="Раз в сутки перед запуском игры"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Максимальный размер:" Style="{StaticResource SettingsLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBox Width="70"
                                                 Text="2000"
                                                 Style="{StaticResource SettingsTextBoxStyle}"/>
                                        <TextBlock Text="МБ"
                                                   FontFamily="Arial"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Margin="5,0"/>
                                        <TextBlock Text="?"
                                                   Foreground="#2B95D7"
                                                   FontFamily="Arial"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Время хранения бэкапа:" Style="{StaticResource SettingsLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBox Width="60"
                                                 Text="30"
                                                 Style="{StaticResource SettingsTextBoxStyle}"/>
                                        <TextBlock Text="Дней"
                                                   FontFamily="Arial"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Margin="5,0"/>
                                        <TextBlock Text="?"
                                                   Foreground="#2B95D7"
                                                   FontFamily="Arial"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <Button Content="Получить лог для поддержки"
                                        Width="258"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource SettingsOutlineButtonStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Button Content="Полный сброс"
                                        Width="130"
                                        Style="{StaticResource SettingsRedButtonStyle}"
                                        Click="SettingsResetAll_Click"/>
                                <Button Content="По умолчанию"
                                        Width="118"
                                        Margin="14,0,0,0"
                                        Style="{StaticResource SettingsGreenButtonStyle}"
                                        Click="SettingsDefault_Click"/>
                                <Button Content="Сохранить"
                                        Width="118"
                                        Margin="14,0,0,0"
                                        Style="{StaticResource SettingsOrangeButtonStyle}"
                                        Click="SettingsSave_Click"/>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="SettingsPrivacyTab" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="40"/>
                            </Grid.RowDefinitions>

                            <StackPanel Margin="18,14,18,0">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Аналитика:" Style="{StaticResource SettingsLabelStyle}"/>
                                    <CheckBox Grid.Column="1"
                                              Content="Отключить отправление анонимной статистики"
                                              Style="{StaticResource SettingsCheckBoxStyle}"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Защитник:" Style="{StaticResource SettingsLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <CheckBox Content="Защищать вас с помощью TLauncher Guard"
                                                  IsChecked="True"
                                                  Style="{StaticResource SettingsCheckBoxStyle}"/>
                                        <TextBlock Text="?"
                                                   Foreground="#2B95D7"
                                                   FontFamily="Arial"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Discord:" Style="{StaticResource SettingsLabelStyle}"/>
                                    <CheckBox Grid.Column="1"
                                              Content="Отображать статус лаунчера в Discord"
                                              IsChecked="True"
                                              Style="{StaticResource SettingsCheckBoxStyle}"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Рекомендации:" Style="{StaticResource SettingsLabelStyle}"/>
                                    <CheckBox Grid.Column="1"
                                              Content="Добавлять иногда сервера в Minecraft"
                                              IsChecked="True"
                                              Style="{StaticResource SettingsCheckBoxStyle}"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Собранная аналитика:"
                                               Style="{StaticResource SettingsLabelStyle}"
                                               VerticalAlignment="Top"
                                               Margin="0,4,0,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="TLauncher не собирает конфиденциальную или личную информацию с вашего компьютера. Собранная анонимная аналитическая информация касается только использования нашей программы и не содержит информации для идентификации человека. Аналитика собирается в соответствии с нашей «Политикой Конфиденциальности», для улучшения качества программы. Вы можете запросить удаление информации с наших серверов."
                                               Foreground="#222222"
                                               FontFamily="Arial"
                                               FontSize="10"
                                               TextWrapping="Wrap"/>
                                </Grid>

                                <Button Content="Запросить удаление аналитики"
                                        Width="250"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource SettingsRedButtonStyle}"/>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Документы:" Style="{StaticResource SettingsLabelStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="Политика конфиденциальности TLauncher"
                                               Foreground="#7DB9DE"
                                               FontFamily="Arial"
                                               FontSize="10"/>
                                </Grid>

                                <Button Content="О программе"
                                        Width="238"
                                        HorizontalAlignment="Center"
                                        Margin="0,12,0,0"
                                        Style="{StaticResource SettingsGreenButtonStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Button Content="По умолчанию"
                                        Width="118"
                                        Style="{StaticResource SettingsGreenButtonStyle}"
                                        Click="SettingsDefault_Click"/>
                                <Button Content="Сохранить"
                                        Width="118"
                                        Margin="16,0,0,0"
                                        Style="{StaticResource SettingsOrangeButtonStyle}"
                                        Click="SettingsSave_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        </Grid>
    </Border>
</Window>

