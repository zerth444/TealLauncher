                                                  Style="{StaticResource SettingsCheckBoxStyle}"
                                                  Margin="0,0,0,2"/>
                                        <CheckBox Content="Отображать Бета (2010-2011 гг.)"
                                                  Style="{StaticResource SettingsCheckBoxStyle}"
                                                  Margin="0,0,0,2"/>
                                        <CheckBox Content="Отображать Альфа (2010 г.)"
                                                  Style="{StaticResource SettingsCheckBoxStyle}"/>
                                    </StackPanel>
                                </Grid>

