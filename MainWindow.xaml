                                              Content="Использовать язык TLauncher в Minecraft"
                                              IsChecked="True"
                                              Style="{StaticResource SettingsCheckBoxStyle}"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
