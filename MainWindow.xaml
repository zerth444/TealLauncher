                                            <TextBlock Grid.Column="4" Text="13148" Foreground="#555555" FontFamily="Arial" FontSize="9" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="16307" Foreground="#555555" FontFamily="Arial" FontSize="9" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Button Content="По умолчанию"
                                        Width="118"
                                        Style="{StaticResource SettingsGreenButtonStyle}"
                                        Click="SettingsDefault_Click"/>
                                <Button Content="Сохранить"
                                        Width="118"
                                        Margin="16,0,0,0"
                                        Style="{StaticResource SettingsOrangeButtonStyle}"
                                        Click="SettingsSave_Click"/>
                            </StackPanel>
                        </Grid>

