                    </Border>

                    <StackPanel Margin="10,8,26,0">
                        <!-- Блок меню -->
                        <Button Height="36"
                                Margin="0,0,0,5"
                                Style="{StaticResource PanelButtonStyle}">
                            <StackPanel Orientation="Horizontal"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                <Border Width="32"
                                        Height="32"
                                        Background="#67AEDE"
                                        CornerRadius="16"
                                        Margin="0,0,12,0">
                                    <TextBlock Text="&#xE897;"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="#FFFFFF"
                                               FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="ПОМОЩЬ"
                                           Foreground="#FFFFFF"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Height="36"
                                Margin="0,0,0,5"
                                Style="{StaticResource PanelButtonStyle}">
                            <StackPanel Orientation="Horizontal"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                <Border Width="32"
                                        Height="32"
                                        Background="#67AEDE"
                                        CornerRadius="16"
                                        Margin="0,0,12,0">
                                    <TextBlock Text="&#xE946;"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="#FFFFFF"
                                               FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="О ЛАУНЧЕРЕ"
                                           Foreground="#FFFFFF"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Height="36"
                                Margin="0,0,0,5"
                                Style="{StaticResource PanelButtonStyle}">
                            <StackPanel Orientation="Horizontal"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                <Border Width="32"
                                        Height="32"
                                        Background="#67AEDE"
                                        CornerRadius="16"
                                        Margin="0,0,12,0">
                                    <TextBlock Text="&#xE909;"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="#FFFFFF"
                                               FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="ГЛАВНЫЙ САЙТ"
                                           Foreground="#FFFFFF"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Кнопки соцсетей -->
                        <Button Height="36"
                                Margin="0,4,0,0"
                                Style="{StaticResource PanelButtonStyle}"
                                Background="#229ED9">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Stretch">
                                <Border Width="36"
                                        Height="36"
                                        Background="#1B7FAF"
                                        BorderBrush="#33FFFFFF"
                                        BorderThickness="0,0,1,0">
                                    <TextBlock Text="D"
                                               Foreground="#FFFFFF"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="DISCORD"
                                           Foreground="#FFFFFF"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Height="36"
                                Margin="0,4,0,0"
                                Style="{StaticResource PanelButtonStyle}"
                                Background="#229ED9">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Stretch">
                                <Border Width="36"
                                        Height="36"
                                        Background="#1B7FAF"
                                        BorderBrush="#33FFFFFF"
                                        BorderThickness="0,0,1,0">
                                    <TextBlock Text="&#xE724;"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="#FFFFFF"
                                               FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="TELEGRAM"
                                           Foreground="#FFFFFF"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Height="36"
                                Margin="0,4,0,0"
                                Style="{StaticResource PanelButtonStyle}"
