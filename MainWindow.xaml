                                                           Foreground="{DynamicResource PanelText}"
                                                           FontFamily="{DynamicResource Font.Arial}"
                                                           FontSize="10"
                                                           Margin="24,0,0,0"/>
                                                <TextBlock Text="{Binding GameVersionText}"
                                                           Foreground="{DynamicResource PanelText}"
                                                           FontFamily="{DynamicResource Font.Arial}"
                                                           FontSize="10"
                                                           Margin="24,0,0,0"/>
                                            </WrapPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    HorizontalAlignment="Right">
                                            <Button Content="{Binding ActionText}" IsEnabled="{Binding CanInstall}"
                                                    Width="100"
                                                    Height="26"
                                                    Style="{DynamicResource SettingsOrangeButtonStyle}"
                                                    Tag="{Binding}"
                                                    Click="InstallModsProject_Click"/>
                                            <Button Style="{DynamicResource SectionButtonStyle}" Content="Подробнее" Tag="{Binding}" Click="ModsProjectDetails_Click" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PanelAccent}" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button x:Name="ModsLoadMoreButton"
                            Content="Показать ещё"
                            Width="160"
                            Height="30"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,18"
                            Style="{DynamicResource SettingsOrangeButtonStyle}"
                            Visibility="Collapsed"
                            Click="ModsLoadMore_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" MaxWidth="600" TextAlignment="Center" x:Name="ModsStatusText"
                           Text="Загрузка..."
                           Foreground="{DynamicResource PanelMuted}"
                           FontFamily="{DynamicResource Font.Arial}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
                <Grid TextElement.Foreground='{DynamicResource PanelText}' x:Name='ModsDetailsPanel' Grid.Row='1' Grid.Column='1' Background='{DynamicResource PanelSurface}' Margin='16,0,14,8' Visibility='Collapsed'>
                    <Grid.RowDefinitions><RowDefinition Height='Auto'/><RowDefinition Height='Auto'/><RowDefinition Height='Auto'/><RowDefinition Height='*'/><RowDefinition Height='Auto'/></Grid.RowDefinitions>
                    <Button Style="{DynamicResource SectionButtonStyle}" Content='← Каталог' Click='CloseProjectPage_Click' HorizontalAlignment='Left' Background='Transparent' BorderThickness='0' Foreground='{DynamicResource PanelAccent}' Padding='0,6'/>
                    <TextBlock x:Name='ModsDetailsTitle' Grid.Row='1' FontSize='24' FontWeight='Bold' TextWrapping='Wrap' Margin='0,8'/>
                    <TextBlock x:Name='ModsDetailsSubtitle' Grid.Row='2' Foreground='{DynamicResource PanelMuted}' TextWrapping='Wrap' Margin='0,0,0,14'/>
                    <FlowDocumentScrollViewer x:Name='ModsDetailsBody' Grid.Row='3' IsToolBarVisible='False' VerticalScrollBarVisibility='Auto' HorizontalScrollBarVisibility='Disabled' BorderThickness='0' Background='Transparent'/>
                    <WrapPanel Grid.Row='4' Margin='0,12,0,0'>
                        <Button Style="{DynamicResource SectionButtonStyle}" x:Name='ModsDetailsInstall' Content='Установить' Click='ProjectPageInstall_Click' Padding='16,7' Margin='0,0,10,0' Background='{DynamicResource Brush.278BC2}' Foreground='{DynamicResource Brush.White}' BorderThickness='0'/>
                        <Button Style="{DynamicResource SectionButtonStyle}" x:Name='ModsDetailsToggle' Content='Выключить' Click='ProjectPageToggle_Click' Padding='12,6' Margin='0,0,10,0'/>
                        <Button Style="{DynamicResource SectionButtonStyle}" x:Name='ModsDetailsRemove' Content='Удалить из сборки' Click='ProjectPageRemove_Click' Padding='12,6'/>
                    </WrapPanel>
                </Grid>
            </Grid>
            <Border x:Name="ModsOperationPanel" Grid.Row="3" Background="{DynamicResource PanelAlert}" BorderBrush="{DynamicResource SectionBorder}" BorderThickness="0,1,0,0" Padding="16,10" Visibility="Collapsed" CornerRadius="{DynamicResource ModsRadius}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ModsOperationTitle" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PanelAccent}"/>
                        <TextBlock x:Name="ModsOperationDetail" Margin="0,4,12,0" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar x:Name="ModsOperationProgress" Height="6" Margin="0,7,12,5" Maximum="100"/>
                        <TextBlock x:Name="ModsOperationSummary" Foreground="{DynamicResource PanelMuted}" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <Button Style="{DynamicResource SectionButtonStyle}" x:Name="ModsDismissButton" Content="✕" Width="26" Height="24" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" ToolTip="Закрыть уведомление" Click="DismissModsOperation_Click"/>
                        <Button Style="{DynamicResource SectionButtonStyle}" x:Name="ModsCancelButton" Content="Отменить" Click="CancelModsOperation_Click" Padding="12,4"/>
                        <Button Style="{DynamicResource SectionButtonStyle}" x:Name="ModsRetryButton" Content="Повторить" Click="ModsRetry_Click" Padding="12,4" Visibility="Collapsed"/>
                        <Button Style="{DynamicResource SectionButtonStyle}" Content="Журнал" Click="ModsLog_Click" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PanelAccent}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Button Style="{DynamicResource SectionButtonStyle}" x:Name="ModsShowProgressButton" Grid.Row="3" Content="Идёт установка — показать прогресс"
                    Click="ShowModsOperation_Click" HorizontalAlignment="Right" Padding="12,5" Margin="8,3"
                    Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PanelAccent}" Visibility="Collapsed"/>
        </Grid>

        <Grid TextElement.Foreground="{DynamicResource PanelText}" x:Name="SettingsOverlay" local:GlassMotion.Enabled="{DynamicResource MotionEnabled}"
              Grid.RowSpan="3"
              Grid.ColumnSpan="2"
              Panel.ZIndex="100"
              Background="{DynamicResource Brush.01000000}"
              Visibility="Collapsed">
            <Border Width="613"
                    Height="512"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,58,0,0"
                    Background="{DynamicResource PanelSurface}"
                    BorderBrush="{DynamicResource SectionBorder}"
                    BorderThickness="1" CornerRadius="{DynamicResource SurfaceRadius}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource PanelHeader}" CornerRadius="{DynamicResource SurfaceRadius}">
                        <Grid>
                            <Button Style="{DynamicResource SectionButtonStyle}" Content="←"
                                    Width="32"
                                    Height="26"
                                    HorizontalAlignment="Left"
                                    Background="Transparent"
                                    Foreground="{DynamicResource OnGlass}"
                                    BorderThickness="0"
                                    FontFamily="{DynamicResource Font.Arial}"
                                    FontSize="17"
                                    Cursor="Hand"
                                    Click="CloseSettings_Click"/>
                            <TextBlock Text="Настройки/Дополнительно"
                                       Foreground="{DynamicResource OnGlass}"
                                       FontFamily="{DynamicResource Font.Arial}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Button Grid.Row="1"
                            Content="Запуск Minecraft"
                            Style="{DynamicResource SettingsTabButtonStyle}"
                            Background="{DynamicResource PanelSurface}"
                            Foreground="{DynamicResource PanelAccent}"/>

                    <Grid Grid.Row="2">
                        <Grid x:Name="SettingsLaunchTab">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="40"/>
                            </Grid.RowDefinitions>

                            <StackPanel Margin="18,12,18,0">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Директория:" Style="{DynamicResource SettingsLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBox x:Name="SettingsDirectoryTextBox"
                                                 Width="360"
                                                 IsReadOnly="True"
                                                 Style="{DynamicResource SettingsTextBoxStyle}"/>
                                        <Button Content="Обзор..."
                                                Width="70"
                                                Height="25"
                                                Margin="6,0,0,0"
                                                Style="{DynamicResource SettingsGreenButtonStyle}"
                                                Click="SettingsBrowse_Click"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Разрешение:" Style="{DynamicResource SettingsLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBox x:Name="SettingsWidthTextBox"
                                                 Width="70"
                                                 Text="925"
                                                 Style="{DynamicResource SettingsTextBoxStyle}"/>
                                        <TextBlock Text="X"
                                                   FontFamily="{DynamicResource Font.Arial}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0"/>
                                        <TextBox x:Name="SettingsHeightTextBox"
                                                 Width="70"
                                                 Text="530"
                                                 Style="{DynamicResource SettingsTextBoxStyle}"/>
                                        <CheckBox x:Name="SettingsFullscreenCheckBox"
                                                  Content="Полноэкранный режим"
                                                  Style="{DynamicResource SettingsCheckBoxStyle}"
                                                  Margin="20,0,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Список версий:"
                                               Style="{DynamicResource SettingsLabelStyle}"
                                               VerticalAlignment="Top"
                                               Margin="0,4,0,0"/>
                                    <StackPanel Grid.Column="1">
                                        <CheckBox x:Name="SettingsSnapshotsCheckBox" Checked="VersionVisibilityChanged" Unchecked="VersionVisibilityChanged" Content="Отображать Снапшоты (&quot;Snapshots&quot;)"
                                                  Style="{DynamicResource SettingsCheckBoxStyle}"
                                                  Margin="0,0,0,2"/>
                                        <CheckBox x:Name="SettingsModifiedCheckBox" Checked="VersionVisibilityChanged" Unchecked="VersionVisibilityChanged" Content="Отображать модифицированные"
                                                  IsChecked="True"
                                                  Style="{DynamicResource SettingsCheckBoxStyle}"
                                                  Margin="0,0,0,2"/>
                                        <CheckBox x:Name="SettingsOldReleasesCheckBox" Checked="VersionVisibilityChanged" Unchecked="VersionVisibilityChanged" Content="Отображать старые релизы (до 1.5.2)"
                                                  IsChecked="True"
                                                  Style="{DynamicResource SettingsCheckBoxStyle}"
                                                  Margin="0,0,0,2"/>
                                        <CheckBox x:Name="SettingsBetaCheckBox" Checked="VersionVisibilityChanged" Unchecked="VersionVisibilityChanged" Content="Отображать Бета (2010-2011 гг.)"
                                                  Style="{DynamicResource SettingsCheckBoxStyle}"
                                                  Margin="0,0,0,2"/>
                                        <CheckBox x:Name="SettingsAlphaCheckBox" Checked="VersionVisibilityChanged" Unchecked="VersionVisibilityChanged" Content="Отображать Альфа (2010 г.)"
                                                  Style="{DynamicResource SettingsCheckBoxStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Язык:" Style="{DynamicResource SettingsLabelStyle}"/>
                                    <CheckBox x:Name="SettingsRussianCheckBox" Grid.Column="1"
                                              Content="Русский язык при первом запуске Minecraft"
                                              IsChecked="True"
                                              Style="{DynamicResource SettingsCheckBoxStyle}"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Minecraft аргументы:" Style="{DynamicResource SettingsLabelStyle}"/>
                                    <Grid Grid.Column="1">
                                        <TextBox x:Name="SettingsArgumentsTextBox"
                                                 Style="{DynamicResource SettingsTextBoxStyle}"/>
                                        <TextBlock Text="Minecraft-аргументы (напр. --server 127.0.0.1)"
                                                   Foreground="{DynamicResource PanelPlaceholder}"
                                                   FontFamily="{DynamicResource Font.Arial}"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"
                                                   Margin="7,0,0,0"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=SettingsArgumentsTextBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Выбор Java:" Style="{DynamicResource SettingsLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ComboBox x:Name="SettingsJavaComboBox"
                                                  Width="305"
                                                  Style="{DynamicResource SettingsComboBoxStyle}"
                                                  SelectedIndex="0">
                                            <ComboBoxItem Content="По умолчанию"/>
                                        </ComboBox>
                                        <Button Content="Изменить"
                                                Width="70"
                                                Height="25"
                                                Margin="6,0,0,0"
                                                Style="{DynamicResource SettingsGreenButtonStyle}"
                                                Click="SettingsJavaBrowse_Click"/>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Выделение памяти:"
                                               Style="{DynamicResource SettingsLabelStyle}"
                                               VerticalAlignment="Top"
                                               Margin="0,4,0,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="SettingsMemoryValue"
                                                   Text="10871 МБ"
                                                   Foreground="{DynamicResource PanelText}"
                                                   FontFamily="{DynamicResource Font.Arial}"
                                                   FontSize="10"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,0,0,2"/>
                                        <Slider x:Name="SettingsMemorySlider"
                                                Minimum="512"
                                                Maximum="16307"
                                                Value="10871"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                ValueChanged="SettingsMemorySlider_ValueChanged"/>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="512" Foreground="{DynamicResource PanelMuted}" FontFamily="{DynamicResource Font.Arial}" FontSize="9"/>
                                            <TextBlock Grid.Column="1" Text="3671" Foreground="{DynamicResource PanelMuted}" FontFamily="{DynamicResource Font.Arial}" FontSize="9" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="6830" Foreground="{DynamicResource PanelMuted}" FontFamily="{DynamicResource Font.Arial}" FontSize="9" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="9989" Foreground="{DynamicResource PanelMuted}" FontFamily="{DynamicResource Font.Arial}" FontSize="9" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="13148" Foreground="{DynamicResource PanelMuted}" FontFamily="{DynamicResource Font.Arial}" FontSize="9" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="16307" Foreground="{DynamicResource PanelMuted}" FontFamily="{DynamicResource Font.Arial}" FontSize="9" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <CheckBox x:Name='SettingsLegacyDesignCheckBox' Style='{DynamicResource SettingsCheckBoxStyle}' Content='Легаси-дизайн (прежнее оформление)' Margin='0,0,20,0' VerticalAlignment='Center'
                                          ToolTip='По умолчанию используется современная тема. Применяется после сохранения.'/>
                                <Button Content="По умолчанию"
                                        Width="118"
                                        Style="{DynamicResource SettingsGreenButtonStyle}"
                                        Click="SettingsDefault_Click"/>
                                <Button Content="Сохранить"
                                        Width="118"
                                        Margin="16,0,0,0"
                                        Style="{DynamicResource SettingsOrangeButtonStyle}"
                                        Click="SettingsSave_Click"/>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name='SettingsLauncherTab' Visibility='Collapsed'>
                            <Grid.RowDefinitions>
                                <RowDefinition Height='*'/>
                                <RowDefinition Height='40'/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin='18,16'>
                                <TextBlock Text='Поведение лаунчера' FontWeight='Bold' FontSize='14' Margin='0,0,0,14'/>
                                <TextBlock Text='При запуске Minecraft' Margin='0,0,0,4'/>
                                <ComboBox x:Name='SettingsLaunchBehaviorCombo' Style='{DynamicResource SettingsComboBoxStyle}' SelectedIndex='0' Margin='0,0,0,12'>
                                    <ComboBoxItem Content='Оставлять лаунчер открытым'/>
                                    <ComboBoxItem Content='Сворачивать лаунчер'/>
                                </ComboBox>
                                <TextBlock Text='Параллельные загрузки модов и сборок' Margin='0,0,0,4'/>
                                <ComboBox x:Name='SettingsParallelCombo' Style='{DynamicResource SettingsComboBoxStyle}' SelectedIndex='1' Margin='0,0,0,16'>
                                    <ComboBoxItem Content='2 — щадящее соединение'/>
                                    <ComboBoxItem Content='4 — по умолчанию'/>
                                    <ComboBoxItem Content='8 — быстрое соединение'/>
                                </ComboBox>
                                <CheckBox x:Name='SettingsBackupsCheckBox' Content='Резервировать миры раз в сутки перед запуском' IsChecked='True' Margin='0,0,0,12'/>
                                <WrapPanel Margin='0,0,0,12'>
                                    <TextBlock Text='Лимит копий, МБ:' VerticalAlignment='Center' Margin='0,0,8,0'/>
                                    <TextBox x:Name='SettingsBackupLimitTextBox' Text='2000' Width='65' Padding='5,3' Margin='0,0,16,0'/>
                                    <TextBlock Text='Хранить, дней:' VerticalAlignment='Center' Margin='0,0,8,0'/>
                                    <TextBox x:Name='SettingsBackupDaysTextBox' Text='30' Width='55' Padding='5,3'/>
                                </WrapPanel>
                                <TextBlock Text='Копии сохраняются в папке backups рядом с мирами. Сброс настроек не удаляет игровые файлы.' TextWrapping='Wrap' Foreground='{DynamicResource PanelMuted}' Margin='0,0,0,18'/>
                                <Button Style="{DynamicResource SectionButtonStyle}" Content='Открыть последний журнал' HorizontalAlignment='Left' Padding='12,6' Click='SettingsSupportLog_Click'/>
                            </StackPanel>
                            <StackPanel Grid.Row='1' Orientation='Horizontal' HorizontalAlignment='Center'>
                                <Button Style="{DynamicResource SectionButtonStyle}" Content='Сбросить настройки' Padding='12,6' Click='SettingsResetAll_Click'/>
                                <Button Style="{DynamicResource SectionButtonStyle}" Content='По умолчанию' Padding='12,6' Margin='10,0' Click='SettingsDefault_Click'/>
                                <Button Style="{DynamicResource SectionButtonStyle}" Content='Сохранить' Padding='12,6' Click='SettingsSave_Click'/>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name='SettingsPrivacyTab' Visibility='Collapsed'>
                            <StackPanel Margin='22'>
                                <TextBlock Text='Конфиденциальность' FontSize='18' FontWeight='Bold' Margin='0,0,0,16'/>
                                <TextBlock Text='У лаунчера нет собственной отправки аналитики, добавления серверов или интеграции со статусом Discord. Прежние переключатели этих функций были нерабочими и удалены.' TextWrapping='Wrap' Margin='0,0,0,12'/>
                                <TextBlock Text='Никнейм и настройки хранятся локально. Для каталога и скачивания файлов используются сервисы Mojang, Modrinth и выбранных загрузчиков.' TextWrapping='Wrap' Foreground='{DynamicResource PanelMuted}'/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        </Grid>
    </Border>
</Window>

