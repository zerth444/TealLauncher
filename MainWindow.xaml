<Window x:Class="TealLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TealLauncher"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Icon="pack://application:,,,/TealLauncher;component/Assets/launcher.ico"
        Title="Teal Launcher"
        Width="1066"
        Height="694"
        MinWidth="1066"
        MinHeight="650"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded" FontFamily="{DynamicResource Font.Ui}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>



    <Border local:GlassMotion.Enabled="{DynamicResource MotionEnabled}" Background="{DynamicResource WindowGlass}"
            BorderBrush="{DynamicResource Brush.7A7A7A}"
            BorderThickness="0" CornerRadius="{DynamicResource SurfaceRadius}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="{DynamicResource FooterHeight}"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="248"/>
            </Grid.ColumnDefinitions>

            <Image Source="Assets/background-launcher.png" Grid.RowSpan="3" Grid.ColumnSpan="2" Stretch="UniformToFill" Visibility="{DynamicResource ModernOnly}" IsHitTestVisible="False"><Image.Effect><BlurEffect Radius="2.5"/></Image.Effect></Image>
            <!-- КАСТОМНЫЙ ЗАГОЛОВОК ОКНА -->
            <Border Grid.Row="0"
                    Grid.ColumnSpan="2"
                    BorderBrush="{DynamicResource Brush.B8B8B8}"
                    BorderThickness="0,0,0,1" CornerRadius="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{DynamicResource Color.FAFAFA}" Offset="0"/>
                        <GradientStop Color="{DynamicResource Color.E6E6E6}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Область перетаскивания окна -->
                    <Border Grid.Column="0"
                            Background="Transparent"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" CornerRadius="0">
                        <StackPanel Orientation="Horizontal"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                            <Image Source="Assets/launcher.png" Width="16" Height="16" Margin="0,0,7,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Teal Launcher"
                                       Foreground="{DynamicResource Brush.333333}"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="—"
                                ToolTip="Свернуть"
                                Style="{DynamicResource CaptionButtonStyle}"
                                Click="MinimizeButton_Click"/>
                        <Button x:Name="MaximizeRestoreButton"
                                Content="□"
                                ToolTip="Развернуть"
                                Style="{DynamicResource CaptionButtonStyle}"
                                Click="MaximizeRestoreButton_Click"/>
                        <Button Content="✕"
                                ToolTip="Закрыть"
                                Style="{DynamicResource CloseCaptionButtonStyle}"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ЦЕНТРАЛЬНАЯ ЧАСТЬ -->
            <Grid Grid.Row="1" Grid.Column="0" Background="{DynamicResource CentralBase}">
                <!-- Фоновая картинка -->
                <Image Visibility="{DynamicResource LegacyOnly}" Source="Assets/background-launcher.png" Opacity="{DynamicResource SceneOpacity}"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality"><Image.Effect><BlurEffect Radius="{DynamicResource SceneBlur}"/></Image.Effect></Image>
                <Rectangle Visibility="{DynamicResource LegacyOnly}" Fill="{DynamicResource SceneTint}" IsHitTestVisible="False"/>

                <!-- Белое полотно поверх картинки -->
                <Border Margin="{DynamicResource NewsMargin}"
                        Background="{DynamicResource NewsSurface}"
                        BorderBrush="{DynamicResource NewsBorder}"
                        BorderThickness="1" CornerRadius="{DynamicResource SurfaceRadius}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18"
                                          ShadowDepth="3"
                                          Opacity="0.35"
                                          Color="{DynamicResource Color.000000}"/>
                    </Border.Effect>

                    <!-- Лента новостей -->
                    <ScrollViewer x:Name="NewsScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="22,22,22,18">

                        <TextBlock x:Name="MinecraftUpdatesStatus"
                                   Text="Загрузка обновлений..."
                                   Foreground="{DynamicResource NewsMuted}"
                                   FontSize="12"
                                   Margin="0,0,0,14"/>

                        <ItemsControl x:Name="MinecraftUpdatesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource NewsItemFill}" Padding="{DynamicResource NewsItemPadding}" Margin="{DynamicResource NewsItemMargin}" CornerRadius="{DynamicResource SurfaceRadius}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="{DynamicResource NewsThumbWidth}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Visibility="{DynamicResource ModernOnly}" CornerRadius="10" Margin="0,4,16,4" Height="110" VerticalAlignment="Top" ClipToBounds="True"><Border.Background><ImageBrush ImageSource="{Binding ThumbnailPath}" Stretch="UniformToFill"/></Border.Background></Border><StackPanel Grid.Column="1">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{DynamicResource NewsAccent}"
                                                       FontSize="{DynamicResource NewsHeadingSize}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DateText}"
                                                       Foreground="{DynamicResource NewsMuted}"
                                                       FontSize="{DynamicResource NewsDateSize}"
                                                       VerticalAlignment="Bottom"
                                                       Margin="12,0,0,0"/>
                                        </Grid>

                                        <TextBlock Text="{Binding Summary}"
                                                   Foreground="{DynamicResource NewsText}"
                                                   FontSize="{DynamicResource NewsBodySize}" LineHeight="22"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,6"/>

                                        <TextBlock Text="Читать полностью на Minecraft Wiki"
                                                   Foreground="{DynamicResource NewsAccent}"
                                                   FontSize="{DynamicResource NewsLinkSize}"
                                                   Cursor="Hand"
                                                   Tag="{Binding Url}"
                                                   TextDecorations="Underline"
                                                   MouseLeftButtonUp="MinecraftUpdateLink_Click"/>
                                    </StackPanel></Grid></Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                    </ScrollViewer>
                </Border>

                <Grid VerticalAlignment="Top" Margin="{DynamicResource TopMargin}" Height="{DynamicResource TopHeight}"><Grid.ColumnDefinitions><ColumnDefinition Width="{DynamicResource TopLeft}"/><ColumnDefinition Width="{DynamicResource TopGap}"/><ColumnDefinition Width="{DynamicResource TopRight}"/></Grid.ColumnDefinitions><!-- Рекламная плашка -->
                <Border x:Name="WelcomeCard" Width="{DynamicResource WelcomeWidth}"
                        Height="{DynamicResource WelcomeHeight}"
                        HorizontalAlignment="{DynamicResource TopAlignment}"
                        VerticalAlignment="Top"
                        Margin="{DynamicResource WelcomeMargin}"
                        Background="{DynamicResource PromoSurface}" CornerRadius="{DynamicResource SurfaceRadius}">
                    <Grid>
                        <Button Visibility="{DynamicResource LegacyOnly}" Content="✕"
                                Width="24"
                                Height="24"
                                Margin="0,4,4,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource Brush.4A3A10}"
                                FontSize="11"
                                Cursor="Hand"/>

                        <StackPanel Margin="{DynamicResource WelcomeSpacing}">
                            <Viewbox Width="28"
                                     Height="28"
                                     HorizontalAlignment="Left">
                                <Canvas Width="32" Height="32">
                                    <Path Data="M6,3 H26 V10 C26,17 21,21 16,21 C11,21 6,17 6,10 Z"
                                          Fill="{DynamicResource Brush.2B2B2B}"/>
                                    <Path Data="M6,6 H2 V9 C2,13 5,15 8,15"
                                          Fill="Transparent"
                                          Stroke="{DynamicResource Brush.2B2B2B}"
                                          StrokeThickness="2"/>
                                    <Path Data="M26,6 H30 V9 C30,13 27,15 24,15"
                                          Fill="Transparent"
                                          Stroke="{DynamicResource Brush.2B2B2B}"
                                          StrokeThickness="2"/>
                                    <Rectangle Canvas.Left="14"
                                               Canvas.Top="20"
                                               Width="4"
                                               Height="5"
                                               Fill="{DynamicResource Brush.2B2B2B}"/>
                                    <Rectangle Canvas.Left="9"
                                               Canvas.Top="25"
                                               Width="14"
                                               Height="4"
                                               Fill="{DynamicResource Brush.2B2B2B}"/>
                                </Canvas>
                            </Viewbox>

                            <TextBlock Text="{DynamicResource WelcomeLine1}"
                                       Foreground="{DynamicResource Brush.2B2B2B}"
                                       FontSize="{DynamicResource WelcomeFont}"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                            <TextBlock Text="{DynamicResource WelcomeLine2}"
                                       Foreground="{DynamicResource Brush.2B2B2B}"
                                       FontSize="{DynamicResource WelcomeFont}"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                            <TextBlock Text="{DynamicResource WelcomeSubtitle}"
                                       Foreground="{DynamicResource Brush.2B2B2B}"
                                       FontSize="{DynamicResource BodyFont}"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Популярные сборки Modrinth -->
                <Border x:Name="PopularCard" Grid.Column="2" Width="{DynamicResource PopularWidth}"
                        Height="{DynamicResource PopularHeight}"
                        HorizontalAlignment="{DynamicResource TopAlignment}"
                        VerticalAlignment="Top"
                        Margin="0"
                        Background="{DynamicResource NewsSurface}"
                        BorderBrush="{DynamicResource PopularFrame}"
                        BorderThickness="1" CornerRadius="{DynamicResource SurfaceRadius}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="{DynamicResource PopularHeaderHeight}"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="{DynamicResource Brush.3CAAE8}" CornerRadius="{DynamicResource SurfaceRadius}">
                            <Grid><Button Visibility="{DynamicResource ModernOnly}" Content="Смотреть в Modrinth →" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" Padding="4" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource NewsAccent}" FontSize="11" Style="{DynamicResource NavigationRowStyle}" Click="OpenModrinthModpacks_Click"/><TextBlock Text="Популярные сборки"
                                       Foreground="{DynamicResource PopularHeading}"
                                       FontSize="{DynamicResource PopularHeadingSize}" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="14,0,0,0"/></Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="{DynamicResource PopularFooterHeight}"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <ItemsControl x:Name="PopularModpacksList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="{DynamicResource PopularRowHeight}" Margin="{DynamicResource PopularRowMargin}"
                                                    BorderBrush="{DynamicResource Brush.DDDDDD}"
                                                    BorderThickness="0,0,0,1"
                                                    Background="{DynamicResource PopularRowFill}"
                                                    Cursor="Hand"
                                                    Tag="{Binding ProjectUrl}"
                                                    ToolTip="{Binding Details}"
                                                    MouseLeftButtonUp="PopularModpackRow_MouseLeftButtonUp" CornerRadius="{DynamicResource SurfaceRadius}">
                                                <Grid Margin="8,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{DynamicResource PopularIconWidth}"/><ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image Source="{Binding IconUrl}" Width="{DynamicResource PopularIconSize}" Height="{DynamicResource PopularIconSize}" Stretch="Uniform" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}"
                                                               Foreground="{DynamicResource PopularInk}"
                                                               FontSize="{DynamicResource PopularFont}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,0,8,0" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Visibility="{DynamicResource ModernOnly}" Foreground="{DynamicResource NewsMuted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,8,0"/></StackPanel>
                                                    <TextBlock Grid.Column="2" Text="›" Visibility="{DynamicResource ModernOnly}" Foreground="{DynamicResource NewsMuted}" FontSize="22" VerticalAlignment="Center" Margin="8,0"/><TextBlock Visibility="{DynamicResource LegacyOnly}" Grid.Column="2"
                                                               Text="{Binding DownloadsText}"
                                                               Foreground="{DynamicResource Brush.2B95D7}"
                                                               FontSize="10"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="PopularModpacksStatus"
                                           Text="Загрузка..."
                                           Foreground="{DynamicResource Brush.777777}"
                                           FontSize="10"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </Grid>

                            <Button Visibility="{DynamicResource LegacyOnly}" Grid.Row="1"
                                    Background="{DynamicResource Brush.408AD2}"
                                    BorderThickness="0"
                                    Padding="0"
                                    Cursor="Hand"
                                    Click="OpenModrinthModpacks_Click">
                                <Button.Template><DynamicResource ResourceKey="InlineButton0"/></Button.Template>
                                <TextBlock Text="Смотреть в Modrinth"
                                           Foreground="{DynamicResource Brush.FFFFFF}"
                                           FontSize="10"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
</Grid>

            <!-- НИЖНЯЯ ПАНЕЛЬ -->
            <Grid Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource FooterBase}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="294"/>
                    <ColumnDefinition Width="275"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions><Border Grid.ColumnSpan="5" Background="{DynamicResource FooterMaterial}" BorderBrush="{DynamicResource FooterEdge}" BorderThickness="1" CornerRadius="16" Margin="{DynamicResource FooterMargin}" IsHitTestVisible="False"/>

                <!-- Логин и аккаунты -->
                <Grid Grid.Column="0"
                      Margin="27,11,20,0"
                      VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBox x:Name="EmailTextBox" FontSize="{DynamicResource DockFont}" BorderBrush="{DynamicResource DockFieldEdge}"
                                 Width="247"
                                 Height="{DynamicResource DockFieldHeight}"
                                 HorizontalAlignment="Left"
                                 Background="{DynamicResource DockFieldFill}"
                                 BorderThickness="{DynamicResource DockInputBorder}"
                                 Padding="{DynamicResource DockPadding}"
                                 VerticalContentAlignment="Center"
                                 Foreground="{DynamicResource DockFieldInk}"/>

                        <TextBlock Text="Логин"
                                   Foreground="Gray"
                                   FontSize="{DynamicResource DockFont}"
                                   Margin="7,0,0,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=EmailTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <CheckBox x:Name="AccountsCheckBox" Style="{DynamicResource DockCheckStyle}"
                              Grid.Row="1"
                              Content="Аккаунты"
                              Foreground="{DynamicResource OnGlass}"
                              FontSize="{DynamicResource DockCheckFont}" Opacity="{DynamicResource DockCheckOpacity}"
                              Margin="0,7,0,0"
                              Checked="AccountsCheckBox_Checked"
                              Unchecked="AccountsCheckBox_Unchecked"/>
                </Grid>

                <!-- Версия и обновление клиента -->
                <Grid Grid.Column="1"
                      Margin="0,11,0,0"
                      VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <ComboBox x:Name="VersionComboBox"
                                  TextSearch.TextPath="DisplayName"
                                  IsTextSearchEnabled="True"
                                  VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                  Width="247"
                                  Height="{DynamicResource DockFieldHeight}"
                                  HorizontalAlignment="Left"
                                  Padding="8,0,24,0"
                                  Style="{DynamicResource DockVersionStyle}"
                                  Background="{DynamicResource DockFieldFill}"
                                  BorderBrush="{DynamicResource DockFieldEdge}"
                                  BorderThickness="1"
                                  FontSize="{DynamicResource DockFont}"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="VersionComboBox_SelectionChanged">
                            <ComboBox.GroupStyle>
                                <GroupStyle><GroupStyle.HeaderTemplate><DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource DockGroupInk}" Margin="6,8,0,4"/>
                                </DataTemplate></GroupStyle.HeaderTemplate></GroupStyle>
                            </ComboBox.GroupStyle>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Image Source="Assets/launcher.png" Width="16" Height="16" Margin="0,0,6,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" MaxWidth="205" ToolTip="{Binding DisplayName}"
                                                   Foreground="{DynamicResource DockFieldInk}"
                                                   FontSize="{DynamicResource DockFont}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <CheckBox x:Name="UpdateClientCheckBox" Style="{DynamicResource DockCheckStyle}"
                              Grid.Row="1"
                              Content="Обновить клиент"
                              Foreground="{DynamicResource OnGlass}"
                              FontSize="{DynamicResource DockCheckFont}" Opacity="{DynamicResource DockCheckOpacity}"
                              Margin="0,7,0,0"
                              Checked="UpdateClientCheckBox_Changed"
                              Unchecked="UpdateClientCheckBox_Changed"/>
                </Grid>

                <!-- Кнопка запуска -->
                <Button x:Name="LaunchButton"
                        Grid.Column="2"
                        Content="Играть"
                        Width="240"
                        Height="{DynamicResource PlayHeight}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="0"
                        Background="{DynamicResource PlayMaterial}"
                        Foreground="{DynamicResource Brush.FFFFFF}"
                        FontSize="{DynamicResource PlayFont}"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="LaunchButton_Click">
                    <Button.Template><DynamicResource ResourceKey="InlineButton1"/></Button.Template>
                </Button>

                <!-- Правая группа: моды, обновление, папка игры, настройки -->
                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,31,0">
                    <Button x:Name="ModsButton"
                            Style="{DynamicResource DockIconStyle}"
                            Margin="0,0,20,0"
                            ToolTip="Modrinth"
                            Click="OpenMods_Click">
                        <Grid><Image Visibility="{DynamicResource LegacyOnly}" Source="Assets/modrinth-logo-white.png"
                               Width="24"
                               Height="24"
                               Stretch="Uniform"/><Path Visibility="{DynamicResource ModernOnly}" Width="24" Height="24" Stroke="{DynamicResource GlassIcon}" StrokeThickness="1.6" StrokeLineJoin="Round" Stretch="Uniform" Data="M12,1 L23,7 L23,19 L12,25 L1,19 L1,7 Z M1,7 L12,13 L23,7 M12,13 L12,25"/></Grid>
                    </Button>

                    <Button x:Name="RefreshButton"
                            Style="{DynamicResource DockIconStyle}"
                            Margin="0,0,20,0"
                            ToolTip="Обновить интерфейс"
                            Click="RefreshButton_Click">
                        <TextBlock Text="&#xE72C;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="{DynamicResource OnGlass}"
                                   FontSize="24"/>
                    </Button>

                    <Button Style="{DynamicResource DockIconStyle}"
                            Margin="0,0,20,0"
                            ToolTip="Папка игры"
                            Click="OpenFolderButton_Click">
                        <Path Width="24"
                              Height="24"
                              Stretch="Uniform"
                              Stroke="{DynamicResource GlassIcon}"
                              StrokeThickness="2"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              Data="M 2,5 L 9,5 L 11,7 L 22,7 L 22,19 L 2,19 Z"/>
                    </Button>

                    <Button x:Name="SettingsButton"
                            Style="{DynamicResource DockIconStyle}"
                            ToolTip="Настройки"
                            Click="SettingsButton_Click">
                        <TextBlock Text="&#xE713;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="{DynamicResource OnGlass}"
                                   FontSize="24"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Grid.Column="1" Margin="10,12,12,12" CornerRadius="18" BorderThickness="1" BorderBrush="#557FA4C6" Visibility="{DynamicResource ModernOnly}"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#DF35516D"/><GradientStop Color="#BF1E354E" Offset="1"/></LinearGradientBrush></Border.Background><StackPanel Margin="16,22,12,16"><Grid Margin="0,0,0,26"><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="Assets/launcher.png" Width="40" Height="40"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"><TextBlock Text="Teal Launcher" FontSize="18" FontWeight="SemiBold" Foreground="#F0F7FF"/><TextBlock Text="Лаунчер для Minecraft" FontSize="10" Foreground="#BED0E3" Margin="0,4,0,0"/></StackPanel></Grid><Button Style="{DynamicResource NavigationRowStyle}" Height="48" Margin="0,0,0,8" Background="Transparent" BorderThickness="0" Padding="4,0" HorizontalContentAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="M12,2 A10,10 0 1 1 11.99,2 M9,8 C9,4 16,4 16,8 C16,11 12,10 12,14 M12,18 L12,19" Width="22" Height="22" Stretch="Uniform" Stroke="#D6E9FA" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><TextBlock Grid.Column="1" Text="Помощь" FontSize="15" Foreground="#EDF5FF" Margin="12,0,0,0" VerticalAlignment="Center"/></Grid></Button><Button Style="{DynamicResource NavigationRowStyle}" Height="48" Margin="0,0,0,8" Background="Transparent" BorderThickness="0" Padding="4,0" HorizontalContentAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="M12,2 A10,10 0 1 1 11.99,2 M12,10 L12,18 M12,6 L12,7" Width="22" Height="22" Stretch="Uniform" Stroke="#D6E9FA" StrokeThickness="1.4" StrokeStartLineCap