<Window x:Class="TLauncherRemake.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Teal Launcher"
        Width="1066"
        Height="694"
        MinWidth="1066"
        MinHeight="650"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Кнопки заголовка окна -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="29"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionBorder"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionBorder" Property="Background" Value="#E3E3E3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionBorder" Property="Background" Value="#CFCFCF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionBorder"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionBorder" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionBorder" Property="Background" Value="#C50F1F"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопки правой панели -->
        <Style x:Key="PanelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#5DA2CF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PanelButtonBorder"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PanelButtonBorder" Property="Background" Value="#6FB7E3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PanelButtonBorder" Property="Background" Value="#4A8CB0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопки-иконки в зелёной нижней панели -->
        <Style x:Key="GreenBarIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FooterButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FooterButtonBorder" Property="Background" Value="#7CB342"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FooterButtonBorder" Property="Background" Value="#689F38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Background" Value="#5DA2CF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#3B7FA3"
                                BorderThickness="0">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0"
                                                  Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#C6E9FA"
                                                        CornerRadius="2"
                                                        Margin="2,0">
                                                    <StackPanel VerticalAlignment="Top"
                                                                Margin="0,6,0,0">
                                                        <Rectangle Width="6" Height="1" Fill="#FFFFFF" HorizontalAlignment="Center"/>
                                                        <Rectangle Width="6" Height="1" Fill="#FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                        <Rectangle Width="6" Height="1" Fill="#FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0"
                                                  Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconHoverButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HoverBorder"
                                Background="Transparent"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverBorder" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverBorder" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VersionComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#8E8E8E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder"
                                                Background="#FFFFFF"
                                                BorderBrush="#8E8E8E"
                                                BorderThickness="1">
                                            <Grid>
                                                <Path Data="M 0,0 L 8,0 L 4,5 Z"
                                                      Fill="#222222"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="Background" Value="#F7F7F7"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="#FFFFFF"
                                        BorderBrush="#8E8E8E"
                                        BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="220">
                                    <ScrollViewer Margin="0,2">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SettingsComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource VersionComboBoxStyle}">
            <Setter Property="Height" Value="25"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,0,24,0"/>
        </Style>

        <Style x:Key="SettingsCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CheckBorder"
                                    Width="14"
                                    Height="14"
                                    Background="#FFFFFF"
                                    BorderBrush="#A6A6A6"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Data="M 2,7 L 5,10 L 12,3"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="2"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="6,0,0,0"
                                              VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#408AD2"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#408AD2"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsGreenButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="#679ED2"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsOrangeButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SettingsGreenButtonStyle}">
            <Setter Property="Background" Value="#408AD2"/>
        </Style>

        <Style x:Key="SettingsRedButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SettingsGreenButtonStyle}">
            <Setter Property="Background" Value="#0C5AA6"/>
        </Style>

        <Style x:Key="SettingsOutlineButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SettingsGreenButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#408AD2"/>
            <Setter Property="BorderBrush" Value="#408AD2"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SettingsTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2E8DC5"/>
            <Setter Property="Foreground" Value="#EAF7FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#FFFFFF"
            BorderBrush="#7A7A7A"
            BorderThickness="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="78"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="248"/>
            </Grid.ColumnDefinitions>

            <!-- КАСТОМНЫЙ ЗАГОЛОВОК ОКНА -->
            <Border Grid.Row="0"
                    Grid.ColumnSpan="2"
                    BorderBrush="#B8B8B8"
                    BorderThickness="0,0,0,1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FAFAFA" Offset="0"/>
                        <GradientStop Color="#E6E6E6" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Область перетаскивания окна -->
                    <Border Grid.Column="0"
                            Background="Transparent"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                            <Border Width="16"
                                    Height="16"
                                    Background="#1976D2"
                                    CornerRadius="2"
                                    Margin="0,0,7,0">
                                <TextBlock Text="TL"
                                           Foreground="#FFFFFF"
                                           FontSize="7"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Teal Launcher"
                                       Foreground="#333333"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="—"
                                ToolTip="Свернуть"
                                Style="{StaticResource CaptionButtonStyle}"
                                Click="MinimizeButton_Click"/>
                        <Button x:Name="MaximizeRestoreButton"
                                Content="□"
                                ToolTip="Развернуть"
                                Style="{StaticResource CaptionButtonStyle}"
                                Click="MaximizeRestoreButton_Click"/>
                        <Button Content="✕"
                                ToolTip="Закрыть"
                                Style="{StaticResource CloseCaptionButtonStyle}"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ЦЕНТРАЛЬНАЯ ЧАСТЬ -->
            <Grid Grid.Row="1" Grid.Column="0" Background="#0E2A45">
                <!-- Фоновая картинка -->
                <Image Source="Assets/background-launcher.png"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- Белое полотно поверх картинки -->
                <Border Margin="25,234,26,0"
                        Background="#F5F5F5"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18"
                                          ShadowDepth="3"
                                          Opacity="0.35"
                                          Color="#000000"/>
                    </Border.Effect>

                    <!-- Лента новостей -->
                    <ScrollViewer x:Name="NewsScrollViewer"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="22,22,22,18">

                        <TextBlock x:Name="MinecraftUpdatesStatus"
                                   Text="Загрузка обновлений..."
                                   Foreground="#757575"
                                   FontSize="12"
                                   Margin="0,0,0,14"/>

                        <ItemsControl x:Name="MinecraftUpdatesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,18">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="#1976D2"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DateText}"
                                                       Foreground="#757575"
                                                       FontSize="10"
                                                       VerticalAlignment="Bottom"
                                                       Margin="12,0,0,0"/>
                                        </Grid>

                                        <TextBlock Text="{Binding Summary}"
                                                   Foreground="Black"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,6"/>

                                        <TextBlock Text="Читать полностью на Minecraft Wiki"
                                                   Foreground="#1976D2"
                                                   FontSize="11"
                                                   Cursor="Hand"
                                                   Tag="{Binding Url}"
                                                   TextDecorations="Underline"
                                                   MouseLeftButtonUp="MinecraftUpdateLink_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Рекламная плашка -->
                <Border Width="252"
                        Height="234"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="28,0,0,0"
                        Background="#679ED2">
                    <Grid>
                        <Button Content="✕"
                                Width="24"
                                Height="24"
                                Margin="0,4,4,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#4A3A10"
                                FontSize="11"
                                Cursor="Hand"/>

                        <StackPanel Margin="16,16,16,14">
                            <Viewbox Width="28"
                                     Height="28"
                                     HorizontalAlignment="Left">
                                <Canvas Width="32" Height="32">
                                    <Path Data="M6,3 H26 V10 C26,17 21,21 16,21 C11,21 6,17 6,10 Z"
                                          Fill="#2B2B2B"/>
                                    <Path Data="M6,6 H2 V9 C2,13 5,15 8,15"
                                          Fill="Transparent"
                                          Stroke="#2B2B2B"
                                          StrokeThickness="2"/>
                                    <Path Data="M26,6 H30 V9 C30,13 27,15 24,15"
                                          Fill="Transparent"
                                          Stroke="#2B2B2B"
                                          StrokeThickness="2"/>
                                    <Rectangle Canvas.Left="14"
                                               Canvas.Top="20"
                                               Width="4"
                                               Height="5"
                                               Fill="#2B2B2B"/>
                                    <Rectangle Canvas.Left="9"
                                               Canvas.Top="25"
                                               Width="14"
                                               Height="4"
                                               Fill="#2B2B2B"/>
                                </Canvas>
                            </Viewbox>

                            <TextBlock Text="ПОЛНОСТЬЮ БЕСПЛАТНЫЙ"
                                       Foreground="#2B2B2B"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                            <TextBlock Text="OPEN-SOURCE ЛАУНЧЕР"
                                       Foreground="#2B2B2B"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                            <TextBlock Text="Без рекламы, скрытых платежей и навязанных сервисов. Только игра и удобный запуск."
                                       Foreground="#2B2B2B"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Популярные сборки Modrinth -->
                <Border Width="492"
                        Height="134"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="302,0,0,0"
                        Background="#FFFFFF"
                        BorderBrush="#9E9E9E"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="#3CAAE8">
                            <TextBlock Text="Популярные сборки"
                                       Foreground="#FFFFFF"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="28"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <ItemsControl x:Name="PopularModpacksList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="26"
                                                    BorderBrush="#DDDDDD"
                                                    BorderThickness="0,0,0,1"
                                                    Background="Transparent"
                                                    Cursor="Hand"
                                                    Tag="{Binding ProjectUrl}"
                                                    ToolTip="{Binding Details}"
                                                    MouseLeftButtonUp="PopularModpackRow_MouseLeftButtonUp">
                                                <Grid Margin="8,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}"
                                                               Foreground="#222222"
                                                               FontSize="10"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DownloadsText}"
                                                               Foreground="#2B95D7"
                                                               FontSize="10"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="PopularModpacksStatus"
                                           Text="Загрузка..."
                                           Foreground="#777777"
                                           FontSize="10"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </Grid>

                            <Button Grid.Row="1"
                                    Background="#408AD2"
                                    BorderThickness="0"
                                    Padding="0"
                                    Cursor="Hand"
                                    Click="OpenModrinthModpacks_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
