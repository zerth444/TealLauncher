<Window x:Class="TLauncherRemake.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TLauncher 2.75"
        Width="1024"
        Height="600"
        MinWidth="960"
        MinHeight="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Кнопки заголовка окна -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="29"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionBorder"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionBorder" Property="Background" Value="#E3E3E3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionBorder" Property="Background" Value="#CFCFCF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionBorder"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionBorder" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionBorder" Property="Background" Value="#C50F1F"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопки правой панели -->
        <Style x:Key="PanelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2E86D6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PanelButtonBorder"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PanelButtonBorder" Property="Background" Value="#3D96E3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PanelButtonBorder" Property="Background" Value="#246FB2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопки-иконки внизу правой панели -->
        <Style x:Key="FooterIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FooterButtonBorder"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FooterButtonBorder" Property="Background" Value="#0D47A1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FooterButtonBorder" Property="Background" Value="#0A3A7F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#FFFFFF"
            BorderBrush="#7A7A7A"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <!-- КАСТОМНЫЙ ЗАГОЛОВОК ОКНА -->
            <Border Grid.Row="0"
                    Grid.ColumnSpan="2"
                    BorderBrush="#B8B8B8"
                    BorderThickness="0,0,0,1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FAFAFA" Offset="0"/>
                        <GradientStop Color="#E6E6E6" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Область перетаскивания окна -->
                    <Border Grid.Column="0"
                            Background="Transparent"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                            <Border Width="16"
                                    Height="16"
                                    Background="#1976D2"
                                    CornerRadius="2"
                                    Margin="0,0,7,0">
                                <TextBlock Text="TL"
                                           Foreground="#FFFFFF"
                                           FontSize="7"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="TLauncher 2.75"
                                       Foreground="#333333"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="—"
                                ToolTip="Свернуть"
                                Style="{StaticResource CaptionButtonStyle}"
                                Click="MinimizeButton_Click"/>
                        <Button x:Name="MaximizeRestoreButton"
                                Content="□"
                                ToolTip="Развернуть"
                                Style="{StaticResource CaptionButtonStyle}"
                                Click="MaximizeRestoreButton_Click"/>
                        <Button Content="✕"
                                ToolTip="Закрыть"
                                Style="{StaticResource CloseCaptionButtonStyle}"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ЦЕНТРАЛЬНАЯ ЧАСТЬ -->
            <Grid Grid.Row="1" Grid.Column="0" Background="#FFFFFF">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Новостной баннер -->
                <Border Grid.Row="0" Background="#E8F5E9">
                    <TextBlock Text="Текст новостного баннера-заглушки"
                               Foreground="#2E7D32"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Лента новостей -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,18,20,18">

                        <!-- Новость 1 -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Minecraft 1.16.5"
                                       Foreground="#1976D2"
                                       FontSize="16"
                                       FontWeight="Bold"/>

                            <TextBlock Grid.Column="1"
                                       Text="Дата публикации: 15 марта 2021"
                                       Foreground="#757575"
                                       FontSize="10"
                                       VerticalAlignment="Bottom"/>
                        </Grid>

                        <TextBlock Text="Argloss"
                                   Foreground="Black"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4"/>

                        <TextBlock Text="•  Java lang.IllegalStateException: POI data mismatch: already registered"
                                   Foreground="Black"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="•  Несколько исправлений, связанных с отображением интерфейса и загрузкой данных."
                                   Foreground="Black"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,18"/>

                        <!-- Новость 2 -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Minecraft 1.16.4"
                                       Foreground="#1976D2"
                                       FontSize="16"
                                       FontWeight="Bold"/>

                            <TextBlock Grid.Column="1"
                                       Text="Дата публикации: 02.11.2020"
                                       Foreground="#757575"
                                       FontSize="10"
                                       VerticalAlignment="Bottom"/>
                        </Grid>

                        <TextBlock Text="Патч взаимодействия с социальными сервисами"
                                   Foreground="Black"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4"/>

                        <TextBlock Text="•  Добавлена поддержка новых социальных сетей и улучшено отображение профиля."
                                   Foreground="Black"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="•  Исправлены ошибки при подключении к серверам и обновлении списка версий."
                                   Foreground="Black"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,18"/>

                        <!-- Новость 3 -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Minecraft 1.16.3"
                                       Foreground="#1976D2"
                                       FontSize="16"
                                       FontWeight="Bold"/>

                            <TextBlock Grid.Column="1"
                                       Text="Дата публикации: 10.09.2020"
                                       Foreground="#757575"
                                       FontSize="10"
                                       VerticalAlignment="Bottom"/>
                        </Grid>

                        <TextBlock Text="Исправление ошибок"
                                   Foreground="Black"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4"/>

                        <TextBlock Text="•  Устранены проблемы с загрузкой игровых файлов и отображением новостей."
                                   Foreground="Black"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="•  Повышена стабильность работы лаунчера при переключении версий."
                                   Foreground="Black"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,18"/>

                        <!-- Новость 4 -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Minecraft 1.16.2"
                                       Foreground="#1976D2"
                                       FontSize="16"
                                       FontWeight="Bold"/>

                            <TextBlock Grid.Column="1"
                                       Text="Дата публикации: 11.08.2020"
                                       Foreground="#757575"
                                       FontSize="10"
                                       VerticalAlignment="Bottom"/>
                        </Grid>

                        <TextBlock Text="Новый патч"
                                   Foreground="Black"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4"/>

                        <TextBlock Text="•  Добавлены новые возможности для работы с версиями игры и настройками профиля."
                                   Foreground="Black"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="•  Обновлены тексты-заглушки, чтобы проверить прокрутку ленты новостей."
                                   Foreground="Black"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,2"/>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- НИЖНЯЯ ПАНЕЛЬ -->
            <Grid Grid.Row="2" Grid.Column="0" Background="#8BC34A">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>

                <!-- Колонка 1: email и запомнить меня -->
                <Grid Grid.Column="0"
                      Margin="20,6,10,6"
                      VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBox x:Name="EmailTextBox"
                                 Width="220"
                                 Height="24"
                                 HorizontalAlignment="Left"
                                 Background="#FFFFFF"
                                 BorderThickness="0"
                                 Padding="6,0"
                                 VerticalContentAlignment="Center"
                                 Foreground="Black"/>

                        <TextBlock Text="Введите email"
                                   Foreground="Gray"
                                   FontSize="12"
                                   Margin="7,0,0,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=EmailTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <CheckBox Grid.Row="1"
                              Content="Запомнить меня"
                              Foreground="Black"
                              FontSize="11"
                              Margin="0,3,0,0"/>
                </Grid>

                <!-- Колонка 2: выбор версии и кнопка входа -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ComboBox Width="145"
                              Height="32"
                              Margin="0,0,10,0"
                              Background="#FFFFFF"
                              BorderBrush="#7CB342"
                              BorderThickness="1"
                              FontSize="12"
                              SelectedIndex="0"
                              VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Версия 1.16.5"/>
                        <ComboBoxItem Content="Версия 1.16.4"/>
                        <ComboBoxItem Content="Версия 1.16.3"/>
                        <ComboBoxItem Content="Версия 1.12.2"/>
                        <ComboBoxItem Content="Версия 1.7.10"/>
                    </ComboBox>

                    <Button Content="Войти в игру"
                            Width="250"
                            Height="45"
                            Background="#FBC02D"
                            Foreground="#FFFFFF"
                            FontSize="18"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="5">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Колонка 3: пустое место -->
                <Grid Grid.Column="2"/>
            </Grid>

            <!-- ПРАВАЯ ПАНЕЛЬ -->
            <Grid Grid.Row="1"
                  Grid.RowSpan="2"
                  Grid.Column="1">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1976D2" Offset="0"/>
                        <GradientStop Color="#125BA3" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>

                <StackPanel VerticalAlignment="Top">
                    <!-- Верхняя плашка -->
                    <Border Height="70"
                            BorderBrush="#0D47A1"
                            BorderThickness="0,0,0,1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#2C8FDF" Offset="0"/>
                                <GradientStop Color="#1565B5" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="TLAUNCHER"
                                       Foreground="#FFFFFF"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="ЛАУНЧЕР MINECRAFT"
                                       Foreground="#D6EBFF"
                                       FontSize="8"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="8,4,8,0">
                        <!-- Блок меню -->
                        <Button Height="38"
                                Margin="0,0,0,4"
                                Style="{StaticResource PanelButtonStyle}">
                            <StackPanel Orientation="Horizontal"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="&#xE77B;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="#FFFFFF"
                                           FontSize="15"
                                           Width="22"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="СОЗДАТЬ АККАУНТ"
                                           Foreground="#FFFFFF"
                                           FontSize="11"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Height="38"
                                Margin="0,0,0,4"
                                Style="{StaticResource PanelButtonStyle}">
                            <StackPanel Orientation="Horizontal"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="&#xE72E;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="#FFFFFF"
                                           FontSize="15"
                                           Width="22"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="АВТОРИЗ. TLAUNCHER"
                                           Foreground="#FFFFFF"
                                           FontSize="11"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Height="38"
                                Margin="0,0,0,4"
                                Style="{StaticResource PanelButtonStyle}">
                            <StackPanel Orientation="Horizontal"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="&#xE896;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="#FFFFFF"
                                           FontSize="15"
                                           Width="22"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="УСТАНОВИТЬ ИГРУ"
                                           Foreground="#FFFFFF"
                                           FontSize="11"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Height="38"
                                Margin="0,0,0,4"
                                Style="{StaticResource PanelButtonStyle}">
                            <StackPanel Orientation="Horizontal"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="&#xE768;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="#FFFFFF"
                                           FontSize="14"
                                           Width="22"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="АНИМАЦИЯ С КРЫЛА"
                                           Foreground="#FFFFFF"
                                           FontSize="11"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Кнопки соцсетей -->
                        <Button Height="30"
                                Margin="0,4,0,0"
                                Style="{StaticResource PanelButtonStyle}"
                                Background="#F57C00">
                            <StackPanel Orientation="Horizontal"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                <Border Width="18"
                                        Height="18"
                                        Background="#E65100"
                                        CornerRadius="2"
                                        Margin="0,0,8,0">
                                    <TextBlock Text="TL"
                                               Foreground="#FFFFFF"
                                               FontSize="7"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="TLAUNCHER ORG"
                                           Foreground="#FFFFFF"
                                           FontSize="10"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Height="30"
                                Margin="0,4,0,0"
                                Style="{StaticResource PanelButtonStyle}"
                                Background="#1565C0">
                            <StackPanel Orientation="Horizontal"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                <Border Width="18"
                                        Height="18"
                                        Background="#FFFFFF"
                                        CornerRadius="2"
                                        Margin="0,0,8,0">
                                    <TextBlock Text="f"
                                               Foreground="#1565C0"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="РАБОТА С FACEBOOK"
                                           Foreground="#FFFFFF"
                                           FontSize="10"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Промо-баннеры -->
                        <Border Height="100"
                                Margin="0,8,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1565C0" Offset="0"/>
                                    <GradientStop Color="#0D47A1" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <Grid Margin="10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="40"
                                        Height="40"
                                        Background="#FFFFFF"
                                        CornerRadius="2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="TL"
                                               Foreground="#0D47A1"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="TLAUNCHER"
                                               Foreground="#FFFFFF"
                                               FontSize="14"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="PREMIUM"
                                               Foreground="#FFB300"
                                               FontSize="14"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="[PROMO BANNER 1]"
                                               Foreground="#BBDEFB"
                                               FontSize="9"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Height="100"
                                Margin="0,6,0,0"
                                Background="#BBDEFB">
                            <TextBlock Text="[PROMO BANNER 2]"
                                       Foreground="#0D47A1"
                                       FontWeight="Bold"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Нижние кнопки-иконки -->
                <Grid Height="34"
                      VerticalAlignment="Bottom"
                      Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0">
                        <Button Style="{StaticResource FooterIconButtonStyle}"
                                ToolTip="TLauncher">
                            <TextBlock Text="TL"
                                       Foreground="#FFFFFF"
                                       FontSize="9"
                                       FontWeight="Bold"/>
                        </Button>

                        <Button Style="{StaticResource FooterIconButtonStyle}"
