                              Unchecked="AccountsCheckBox_Unchecked"/>
                </Grid>

                <!-- Версия и обновление клиента -->
                <Grid Grid.Column="1"
                      Margin="0,11,0,0"
                      VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <ComboBox x:Name="VersionComboBox"
