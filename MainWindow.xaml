                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#FFFFFF"
                                                  Data="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="GITHUB"
                                           Foreground="#FFFFFF"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </StackPanel>
            </Grid>

            <ScrollBar Grid.Row="1"
                        Grid.Column="1"
                        Width="14"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Orientation="Vertical"
                        Style="{StaticResource SidebarScrollBarStyle}"
                        Minimum="0"
                        Maximum="{Binding ScrollableHeight, ElementName=NewsScrollViewer}"
                        Value="{Binding VerticalOffset, ElementName=NewsScrollViewer, Mode=OneWay}"
                        ViewportSize="{Binding ViewportHeight, ElementName=NewsScrollViewer}"
                        SmallChange="16"
                        LargeChange="120"
                        ValueChanged="PageScrollBar_ValueChanged"/>

        <Grid x:Name="SettingsOverlay"
              Grid.RowSpan="3"
              Grid.ColumnSpan="2"
              Panel.ZIndex="100"
              Background="#01000000"
              Visibility="Collapsed">
            <Border Width="613"
                    Height="512"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,58,0,0"
                    Background="#F5F5F5"
                    BorderBrush="#8A8A8A"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#2E8DC5">
                        <Grid>
                            <Button Content="←"
                                    Width="32"
                                    Height="26"
                                    HorizontalAlignment="Left"
                                    Background="Transparent"
                                    Foreground="#FFFFFF"
                                    BorderThickness="0"
                                    FontFamily="Arial"
                                    FontSize="17"
                                    Cursor="Hand"
                                    Click="CloseSettings_Click"/>
                            <TextBlock Text="Настройки/Дополнительно"
                                       Foreground="#FFFFFF"
                                       FontFamily="Arial"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Button Grid.Row="1"
                            Content="Запуск Minecraft"
                            Style="{StaticResource SettingsTabButtonStyle}"
                            Background="#F5F5F5"
                            Foreground="#1E88C7"/>

                    <Grid Grid.Row="2">
                        <Grid x:Name="SettingsLaunchTab">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="40"/>
                            </Grid.RowDefinitions>

                            <StackPanel Margin="18,12,18,0">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Директория:" Style="{StaticResource SettingsLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBox x:Name="SettingsDirectoryTextBox"
                                                 Width="360"
                                                 IsReadOnly="True"
                                                 Style="{StaticResource SettingsTextBoxStyle}"/>
                                        <Button Content="Обзор..."
                                                Width="70"
                                                Height="25"
                                                Margin="6,0,0,0"
                                                Style="{StaticResource SettingsGreenButtonStyle}"
                                                Click="SettingsBrowse_Click"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Разрешение:" Style="{StaticResource SettingsLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBox x:Name="SettingsWidthTextBox"
                                                 Width="70"
                                                 Text="925"
                                                 Style="{StaticResource SettingsTextBoxStyle}"/>
                                        <TextBlock Text="X"
                                                   FontFamily="Arial"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0"/>
                                        <TextBox x:Name="SettingsHeightTextBox"
                                                 Width="70"
                                                 Text="530"
                                                 Style="{StaticResource SettingsTextBoxStyle}"/>
                                        <CheckBox x:Name="SettingsFullscreenCheckBox"
                                                  Content="Полноэкранный режим"
                                                  Style="{StaticResource SettingsCheckBoxStyle}"
                                                  Margin="20,0,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Список версий:"
                                               Style="{StaticResource SettingsLabelStyle}"
                                               VerticalAlignment="Top"
                                               Margin="0,4,0,0"/>
                                    <StackPanel Grid.Column="1">
                                        <CheckBox Content="Отображать Снапшоты (&quot;Snapshots&quot;)"
                                                  Style="{StaticResource SettingsCheckBoxStyle}"
                                                  Margin="0,0,0,2"/>
                                        <CheckBox Content="Отображать модифицированные"
                                                  IsChecked="True"
                                                  Style="{StaticResource SettingsCheckBoxStyle}"
                                                  Margin="0,0,0,2"/>
