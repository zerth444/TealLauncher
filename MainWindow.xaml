<Window x:Class="TLauncherRemake.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Teal Launcher"
        Width="1066"
        Height="694"
        MinWidth="1066"
        MinHeight="650"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Кнопки заголовка окна -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="29"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionBorder"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionBorder" Property="Background" Value="#E3E3E3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionBorder" Property="Background" Value="#CFCFCF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionBorder"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionBorder" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionBorder" Property="Background" Value="#C50F1F"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопки правой панели -->
        <Style x:Key="PanelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#5DA2CF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PanelButtonBorder"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PanelButtonBorder" Property="Background" Value="#6FB7E3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PanelButtonBorder" Property="Background" Value="#4A8CB0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопки-иконки в зелёной нижней панели -->
        <Style x:Key="GreenBarIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FooterButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FooterButtonBorder" Property="Background" Value="#7CB342"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FooterButtonBorder" Property="Background" Value="#689F38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Background" Value="#5DA2CF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#3B7FA3"
                                BorderThickness="0">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0"
                                                  Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#C6E9FA"
                                                        CornerRadius="2"
                                                        Margin="2,0">
                                                    <StackPanel VerticalAlignment="Top"
                                                                Margin="0,6,0,0">
                                                        <Rectangle Width="6" Height="1" Fill="#FFFFFF" HorizontalAlignment="Center"/>
                                                        <Rectangle Width="6" Height="1" Fill="#FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                        <Rectangle Width="6" Height="1" Fill="#FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0"
                                                  Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconHoverButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HoverBorder"
                                Background="Transparent"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverBorder" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverBorder" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VersionComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#8E8E8E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder"
                                                Background="#FFFFFF"
                                                BorderBrush="#8E8E8E"
                                                BorderThickness="1">
                                            <Grid>
                                                <Path Data="M 0,0 L 8,0 L 4,5 Z"
                                                      Fill="#222222"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="Background" Value="#F7F7F7"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="#FFFFFF"
                                        BorderBrush="#8E8E8E"
                                        BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="220">
                                    <ScrollViewer Margin="0,2">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#FFFFFF"
            BorderBrush="#7A7A7A"
            BorderThickness="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="78"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="248"/>
            </Grid.ColumnDefinitions>

            <!-- КАСТОМНЫЙ ЗАГОЛОВОК ОКНА -->
            <Border Grid.Row="0"
                    Grid.ColumnSpan="2"
                    BorderBrush="#B8B8B8"
                    BorderThickness="0,0,0,1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FAFAFA" Offset="0"/>
                        <GradientStop Color="#E6E6E6" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Область перетаскивания окна -->
                    <Border Grid.Column="0"
                            Background="Transparent"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                            <Border Width="16"
                                    Height="16"
                                    Background="#1976D2"
                                    CornerRadius="2"
                                    Margin="0,0,7,0">
                                <TextBlock Text="TL"
                                           Foreground="#FFFFFF"
                                           FontSize="7"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Teal Launcher"
                                       Foreground="#333333"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="—"
                                ToolTip="Свернуть"
                                Style="{StaticResource CaptionButtonStyle}"
                                Click="MinimizeButton_Click"/>
                        <Button x:Name="MaximizeRestoreButton"
                                Content="□"
                                ToolTip="Развернуть"
                                Style="{StaticResource CaptionButtonStyle}"
                                Click="MaximizeRestoreButton_Click"/>
                        <Button Content="✕"
                                ToolTip="Закрыть"
                                Style="{StaticResource CloseCaptionButtonStyle}"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ЦЕНТРАЛЬНАЯ ЧАСТЬ -->
            <Grid Grid.Row="1" Grid.Column="0" Background="#0E2A45">
                <!-- Фоновая картинка -->
                <Image Source="Assets/background-launcher.png"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- Белое полотно поверх картинки -->
                <Border Margin="25,234,26,0"
                        Background="#F5F5F5"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18"
                                          ShadowDepth="3"
                                          Opacity="0.35"
                                          Color="#000000"/>
                    </Border.Effect>

                    <!-- Лента новостей -->
                    <ScrollViewer x:Name="NewsScrollViewer"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="22,22,22,18">

                        <!-- Новость 1 -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Версия Minecraft 26.1 уже доступна! ВАЖНО!"
                                       Foreground="#1976D2"
                                       FontSize="16"
                                       FontWeight="Bold"/>
                        </Grid>

                        <TextBlock Text="Если вы столкнулись с ошибкой при запуске версии 26.1, убедитесь, что у вас установлена последняя версия «Teal Launcher». Для этого нажмите на значок шестеренки в углу программы запуска, там вы увидите пункт «Обновить Teal Launcher». Обязательно обновите его!"
                                   Foreground="Black"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,18"/>

                        <!-- Новость 2 -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Minecraft 26.3"
                                       Foreground="#1976D2"
                                       FontSize="16"
                                       FontWeight="Bold"/>

                            <TextBlock Grid.Column="1"
                                       Text="Дата выпуска: 15 сентября 2026 года"
                                       Foreground="#757575"
                                       FontSize="10"
                                       VerticalAlignment="Bottom"/>
                        </Grid>

                        <TextBlock Text="«World Generation»"
                                   Foreground="Black"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4"/>

                        <TextBlock Text="•  «Пятнистый лес» — новый осенний биом, который появляется вблизи холодных регионов. Здесь растут новые деревья — тополя, а также красные кусты, коричневые грибы и травинки, а земля покрыта сухими листьями."
                                   Foreground="Black"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="•  «Заброшенный лагерь» — новое природное сооружение, которое может появляться во многих лесных и равнинных биомах, включая тайгу, саванну, болота, джунгли и вишнёвые рощи."
                                   Foreground="Black"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,18"/>

                        <!-- Новость 3 -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Minecraft 26.2"
                                       Foreground="#1976D2"
                                       FontSize="16"
                                       FontWeight="Bold"/>

                            <TextBlock Grid.Column="1"
                                       Text="Дата выпуска: 12 августа 2026 года"
                                       Foreground="#757575"
                                       FontSize="10"
                                       VerticalAlignment="Bottom"/>
                        </Grid>

                        <TextBlock Text="Исправления и улучшения"
                                   Foreground="Black"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4"/>

                        <TextBlock Text="•  Устранены проблемы с загрузкой игровых файлов и отображением новостей."
                                   Foreground="Black"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="•  Повышена стабильность работы лаунчера при переключении версий."
                                   Foreground="Black"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,18"/>

                        <!-- Новость 4 -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Minecraft 26.1"
                                       Foreground="#1976D2"
                                       FontSize="16"
                                       FontWeight="Bold"/>

                            <TextBlock Grid.Column="1"
                                       Text="Дата выпуска: 15 июля 2026 года"
                                       Foreground="#757575"
                                       FontSize="10"
                                       VerticalAlignment="Bottom"/>
                        </Grid>

                        <TextBlock Text="Новый патч"
                                   Foreground="Black"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4"/>

                        <TextBlock Text="•  Добавлены новые возможности для работы с версиями игры и настройками профиля."
                                   Foreground="Black"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="•  Обновлены тексты-заглушки, чтобы проверить прокрутку ленты новостей."
                                   Foreground="Black"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,18"/>

                        <!-- Новость 5 -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Minecraft 26.0"
                                       Foreground="#1976D2"
                                       FontSize="16"
                                       FontWeight="Bold"/>

                            <TextBlock Grid.Column="1"
                                       Text="Дата выпуска: 20 июня 2026 года"
                                       Foreground="#757575"
                                       FontSize="10"
                                       VerticalAlignment="Bottom"/>
                        </Grid>

                        <TextBlock Text="Стабильность и совместимость"
                                   Foreground="Black"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4"/>

                        <TextBlock Text="•  Исправлены ошибки при работе с профилями и подключении к серверам."
                                   Foreground="Black"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="•  Обновлены библиотеки и улучшена совместимость с модами."
                                   Foreground="Black"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="•  Добавлены новые заглушки для проверки прокрутки ленты."
                                   Foreground="Black"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,2"/>

                    </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Рекламная плашка -->
                <Border Width="252"
                        Height="234"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="28,0,0,0"
                        Background="#679ED2">
                    <Grid>
                        <Button Content="✕"
                                Width="24"
                                Height="24"
                                Margin="0,4,4,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#4A3A10"
                                FontSize="11"
                                Cursor="Hand"/>

                        <StackPanel Margin="16,16,16,14">
                            <Viewbox Width="28"
                                     Height="28"
                                     HorizontalAlignment="Left">
                                <Canvas Width="32" Height="32">
                                    <Path Data="M6,3 H26 V10 C26,17 21,21 16,21 C11,21 6,17 6,10 Z"
                                          Fill="#2B2B2B"/>
                                    <Path Data="M6,6 H2 V9 C2,13 5,15 8,15"
                                          Fill="Transparent"
                                          Stroke="#2B2B2B"
                                          StrokeThickness="2"/>
                                    <Path Data="M26,6 H30 V9 C30,13 27,15 24,15"
                                          Fill="Transparent"
                                          Stroke="#2B2B2B"
                                          StrokeThickness="2"/>
                                    <Rectangle Canvas.Left="14"
                                               Canvas.Top="20"
                                               Width="4"
                                               Height="5"
                                               Fill="#2B2B2B"/>
                                    <Rectangle Canvas.Left="9"
                                               Canvas.Top="25"
                                               Width="14"
                                               Height="4"
                                               Fill="#2B2B2B"/>
                                </Canvas>
                            </Viewbox>

                            <TextBlock Text="ПОЛНОСТЬЮ БЕСПЛАТНЫЙ"
                                       Foreground="#2B2B2B"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                            <TextBlock Text="OPEN-SOURCE ЛАУНЧЕР"
                                       Foreground="#2B2B2B"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                            <TextBlock Text="Без рекламы, скрытых платежей и навязанных сервисов. Только игра и удобный запуск."
                                       Foreground="#2B2B2B"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Рекомендуемые серверы -->
                <Border Width="492"
                        Height="134"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="302,0,0,0"
                        Background="#FFFFFF"
                        BorderBrush="#9E9E9E"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="#3CAAE8">
                            <TextBlock Text="Рекомендуемые серверы"
                                       Foreground="#FFFFFF"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="28"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <Border Height="26"
                                        BorderBrush="#DDDDDD"
                                        BorderThickness="0,0,0,1">
                                    <Grid Margin="8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="BOMJPVP — Бомж резня в коробке, качайся и унижай"
                                                   Foreground="#222222"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="play.bomjpvp.top"
                                                   Foreground="#2B95D7"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border Height="26"
                                        BorderBrush="#DDDDDD"
                                        BorderThickness="0,0,0,1">
                                    <Grid Margin="8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="[Гриф и Выживание] Забирай подарок от админа"
                                                   Foreground="#222222"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="play.mangogrief.ru"
                                                   Foreground="#2B95D7"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border Height="26"
                                        BorderBrush="#DDDDDD"
                                        BorderThickness="0,0,0,1">
                                    <Grid Margin="8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="FunnyMC — Анархия, выживание, BedWars, SkyBlock"
                                                   Foreground="#222222"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="go.funnymc.net"
                                                   Foreground="#2B95D7"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#0C5AA6"
                                        Margin="0,0,1,0">
                                    <TextBlock Text="Ещё сервера"
                                               Foreground="#FFFFFF"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Column="1"
                                        Background="#408AD2"
                                        Margin="1,0">
                                    <TextBlock Text="Добавить сервер"
                                               Foreground="#FFFFFF"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Column="2"
                                        Background="#679ED2"
                                        Margin="1,0,0,0">
                                    <TextBlock Text="Добавить сервер бесплатно"
                                               Foreground="#FFFFFF"
                                               FontSize="9"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- НИЖНЯЯ ПАНЕЛЬ -->
            <Grid Grid.Row="2" Grid.ColumnSpan="2" Background="#04396C">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="294"/>
                    <ColumnDefinition Width="275"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Логин и аккаунты -->
                <Grid Grid.Column="0"
                      Margin="27,11,20,0"
                      VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBox x:Name="EmailTextBox"
                                 Width="247"
                                 Height="25"
                                 HorizontalAlignment="Left"
                                 Background="#FFFFFF"
                                 BorderThickness="0"
                                 Padding="6,0"
                                 VerticalContentAlignment="Center"
                                 Foreground="Black"/>

                        <TextBlock Text="Логин"
                                   Foreground="Gray"
                                   FontSize="12"
                                   Margin="7,0,0,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=EmailTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <CheckBox Grid.Row="1"
                              Content="Аккаунты"
                              Foreground="#FFFFFF"
                              FontSize="13"
                              Margin="0,7,0,0"/>
                </Grid>

                <!-- Версия и обновление клиента -->
                <Grid Grid.Column="1"
                      Margin="0,11,0,0"
                      VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <ComboBox Width="247"
                                  Height="25"
                                  HorizontalAlignment="Left"
                                  Padding="8,0,24,0"
                                  Style="{StaticResource VersionComboBoxStyle}"
                                  Background="#FFFFFF"
                                  BorderBrush="#9E9E9E"
                                  BorderThickness="1"
                                  FontSize="12"
                                  SelectedIndex="0"
                                  VerticalContentAlignment="Center">
                            <ComboBoxItem Padding="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="16" Height="16" Background="#2B95D7" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="2" Margin="0,0,6,0">
                                        <TextBlock Text="TL" Foreground="#FFFFFF" FontSize="7" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Новейшая версия 26.3" Foreground="#222222" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Padding="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="16" Height="16" Background="#2B95D7" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="2" Margin="0,0,6,0">
                                        <TextBlock Text="TL" Foreground="#FFFFFF" FontSize="7" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Версия 1.21.4" Foreground="#222222" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Padding="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="16" Height="16" Background="#2B95D7" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="2" Margin="0,0,6,0">
                                        <TextBlock Text="TL" Foreground="#FFFFFF" FontSize="7" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Версия 1.20.1" Foreground="#222222" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Padding="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="16" Height="16" Background="#2B95D7" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="2" Margin="0,0,6,0">
                                        <TextBlock Text="TL" Foreground="#FFFFFF" FontSize="7" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Версия 1.16.5" Foreground="#222222" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Padding="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="16" Height="16" Background="#2B95D7" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="2" Margin="0,0,6,0">
                                        <TextBlock Text="TL" Foreground="#FFFFFF" FontSize="7" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Версия 1.12.2" Foreground="#222222" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ComboBoxItem>
                        </ComboBox>
                    </Grid>

                    <CheckBox Grid.Row="1"
                              Content="Обновить клиент"
                              Foreground="#FFFFFF"
                              FontSize="13"
                              Margin="0,7,0,0"/>
                </Grid>

                <!-- Кнопка установки -->
                <Button Grid.Column="2"
                        Content="Установить"
                        Width="240"
                        Height="49"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="0,10,0,0"
                        Background="#408AD2"
                        Foreground="#FFFFFF"
                        FontSize="18"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Правая группа: моды, обновление, папка игры, настройки -->
                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,31,0">
                    <Button Style="{StaticResource IconHoverButtonStyle}"
                            Margin="0,0,20,0"
                            ToolTip="Modrinth">
                        <Image Source="Assets/modrinth-logo-white.png"
                               Width="24"
                               Height="24"
                               Stretch="Uniform"/>
                    </Button>

                    <Button Style="{StaticResource IconHoverButtonStyle}"
                            Margin="0,0,20,0"
                            ToolTip="Обновить">
                        <TextBlock Text="&#xE72C;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="#FFFFFF"
                                   FontSize="24"/>
                    </Button>

                    <Button Style="{StaticResource IconHoverButtonStyle}"
                            Margin="0,0,20,0"
                            ToolTip="Папка игры">
                        <Path Width="24"
                              Height="24"
                              Stretch="Uniform"
                              Stroke="#FFFFFF"
                              StrokeThickness="2"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              Data="M 2,5 L 9,5 L 11,7 L 22,7 L 22,19 L 2,19 Z"/>
                    </Button>

                    <Button Style="{StaticResource IconHoverButtonStyle}"
                            ToolTip="Настройки">
                        <TextBlock Text="&#xE713;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="#FFFFFF"
                                   FontSize="24"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ПРАВАЯ ПАНЕЛЬ -->
            <Grid Grid.Row="1"
                  Grid.Column="1">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1D455B" Offset="0"/>
                        <GradientStop Color="#0F2F40" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>

                <StackPanel>
                    <!-- Верхняя плашка -->
                    <Border Height="62"
                            BorderBrush="#3B7FA3"
                            BorderThickness="0,0,0,1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#5AABD6" Offset="0"/>
                                <GradientStop Color="#4283A6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="TEAL LAUNCHER"
                                       Foreground="#FFFFFF"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="ЛАУНЧЕР ДЛЯ MINECRAFT"
                                       Foreground="#D6EBFF"
                                       FontSize="8"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="10,8,26,0">
                        <!-- Блок меню -->
                        <Button Height="36"
                                Margin="0,0,0,5"
                                Style="{StaticResource PanelButtonStyle}">
                            <StackPanel Orientation="Horizontal"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                <Border Width="32"
                                        Height="32"
                                        Background="#67AEDE"
                                        CornerRadius="16"
                                        Margin="0,0,12,0">
                                    <TextBlock Text="&#xE897;"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="#FFFFFF"
                                               FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="ПОМОЩЬ"
                                           Foreground="#FFFFFF"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Height="36"
                                Margin="0,0,0,5"
                                Style="{StaticResource PanelButtonStyle}">
                            <StackPanel Orientation="Horizontal"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                <Border Width="32"
                                        Height="32"
                                        Background="#67AEDE"
                                        CornerRadius="16"
                                        Margin="0,0,12,0">
                                    <TextBlock Text="&#xE946;"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="#FFFFFF"
                                               FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="О ЛАУНЧЕРЕ"
                                           Foreground="#FFFFFF"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Height="36"
                                Margin="0,0,0,5"
                                Style="{StaticResource PanelButtonStyle}">
                            <StackPanel Orientation="Horizontal"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                <Border Width="32"
                                        Height="32"
                                        Background="#67AEDE"
                                        CornerRadius="16"
                                        Margin="0,0,12,0">
                                    <TextBlock Text="&#xE909;"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="#FFFFFF"
                                               FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="ГЛАВНЫЙ САЙТ"
                                           Foreground="#FFFFFF"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Кнопки соцсетей -->
                        <Button Height="36"
                                Margin="0,4,0,0"
                                Style="{StaticResource PanelButtonStyle}"
                                Background="#229ED9">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Stretch">
                                <Border Width="36"
                                        Height="36"
                                        Background="#1B7FAF"
                                        BorderBrush="#33FFFFFF"
                                        BorderThickness="0,0,1,0">
                                    <TextBlock Text="D"
                                               Foreground="#FFFFFF"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="DISCORD"
                                           Foreground="#FFFFFF"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Height="36"
                                Margin="0,4,0,0"
                                Style="{StaticResource PanelButtonStyle}"
                                Background="#229ED9">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Stretch">
                                <Border Width="36"
                                        Height="36"
                                        Background="#1B7FAF"
                                        BorderBrush="#33FFFFFF"
                                        BorderThickness="0,0,1,0">
                                    <TextBlock Text="&#xE724;"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="#FFFFFF"
                                               FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="TELEGRAM"
                                           Foreground="#FFFFFF"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </StackPanel>
            </Grid>

            <ScrollBar Grid.Row="1"
                        Grid.Column="1"
                        Width="14"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Orientation="Vertical"
                        Style="{StaticResource SidebarScrollBarStyle}"
                        Minimum="0"
                        Maximum="{Binding ScrollableHeight, ElementName=NewsScrollViewer}"
                        Value="{Binding VerticalOffset, ElementName=NewsScrollViewer, Mode=OneWay}"
                        ViewportSize="{Binding ViewportHeight, ElementName=NewsScrollViewer}"
                        SmallChange="16"
                        LargeChange="120"
                        ValueChanged="PageScrollBar_ValueChanged"/>
        </Grid>
    </Border>
</Window>
