<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>TLauncherRemake</RootNamespace>
    <AssemblyName>TLauncherRemake</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\background-launcher.png" />
    <Resource Include="Assets\modrinth-logo-white.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CmlLib.Core" Version="4.1.0" />
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.4.0" />
  </ItemGroup>

</Project>
