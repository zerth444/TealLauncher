<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>TealLauncher</RootNamespace>
    <AssemblyName>TealLauncher</AssemblyName>
    <ApplicationIcon>Assets\launcher.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <InternalsVisibleTo Include="Launcher.Tests" />
    <Resource Include="Assets\background-launcher.png" />
    <Resource Include="Assets\modrinth-logo-white.png" />
    <Resource Include="Assets\launcher.png" />
    <Resource Include="Assets\launcher.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CmlLib.Core" Version="4.1.0" />
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.4.0" />
    <PackageReference Include="CmlLib.Core.Installer.Forge" Version="2.0.0" />
  </ItemGroup>

</Project>
